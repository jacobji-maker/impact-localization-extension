{
  "manifest_version": 3,
  "name": "impact.com助手",
  "version": "0.9.10",
  "description": "面向 impact.com 品牌端的第三方中文助手：本地翻译、Shopify 上线指引，通过原生 Ask Impact 询问术语。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "impact.com助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.impact.com/*",
        "https://demo.impact.com/*"
      ],
      "js": [
        "dict.js",
        "site-config.js",
        "settings-contract.js",
        "guidance.js",
        "journey.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://ui.assets.impact.com/onboarding-ui/checklist-assets/production/payout-terms/default.html*",
        "https://ui.assets.impact.com/onboarding-ui/checklist-assets/production/migrated/event-type-validation.html*",
        "https://ui.assets.impact.com/onboarding-ui/checklist-assets/production/operator-json/linkout.html*",
        "https://ui.assets.impact.com/onboarding-ui/checklist-assets/production/operator-json/instructions.html*"
      ],
      "js": [
        "dict.js",
        "site-config.js",
        "settings-contract.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
